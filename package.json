{
  "name": "dsh-skill-scoreboard",
  "version": "1.4.0",
  "description": "DSH skill 使用记分板：监听 tools/result，按会话去重自动累计 skill 加载次数；设置侧边栏显示记分榜页面；agent/pre-step 注入记分榜与 skill 实际路径供 AI 参考（v1.4.0）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "data",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "skills": [
      "./skills/dsh-skill-scoreboard.md"
    ],
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT"
}